# =====================================================
# AuditoriaX — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to git.
# =====================================================

NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/auditoriax

# ===== AUTH SECRETS =====
# Generate strong random strings: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_string
REFRESH_TOKEN_SECRET=replace_with_a_different_long_random_secret_string

# ===== MASTER ADMINS =====
# Comma-separated list of emails that are auto-promoted to Super Admin on first login.
# Do NOT put personal emails in source code — put them here.
MASTER_ADMINS=your_admin_email@yourdomain.com

# ===== RAZORPAY =====
# Get these from https://dashboard.razorpay.com/app/keys
# Use rzp_test_... keys for development, rzp_live_... for production
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX

# ===== EMAIL (Nodemailer via Gmail) =====
# 1. Enable 2-Factor Auth on your Google account
# 2. Go to: Google Account → Security → App Passwords → Generate
# 3. Paste the 16-character App Password below (no spaces, no quotes)
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=xxxx_xxxx_xxxx_xxxx

# ===== APP URL & CORS =====
# Local:      APP_URL=http://localhost:3000
# On Render:  APP_URL=https://auditoriax.onrender.com  (your actual Render URL)
# Add all allowed frontend origins to ALLOWED_ORIGINS (comma-separated)
APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# ===== LOGGING =====
# Log level: error | warn | info | http | debug  (default: info in prod, debug in dev)
LOG_LEVEL=info

# ===== MULTI-TENANT =====
# Set to 'false' to disable institution self-registration
INSTITUTION_REGISTRATION_ENABLED=true

# ===== BOOKING RULES =====
# How many hours before an event students can no longer self-cancel (default: 2)
CANCEL_CUTOFF_HOURS=2

# ===== FUTURE-02: PLATFORM BILLING (Razorpay Fee Split) =====
# Platform fee percentage deducted from each paid ticket.
# The institution receives (ticketPrice - platformFee).
# Example: ticket = ₹200, fee = 10% → AuditoriaX keeps ₹20, institution gets ₹180.
PLATFORM_FEE_FREE=10
PLATFORM_FEE_BASIC=7
PLATFORM_FEE_PREMIUM=5

# Plan limits: max auditoriums and events per month per institution.
PLAN_FREE_MAX_AUDS=3
PLAN_FREE_MAX_EVENTS=10
PLAN_BASIC_MAX_AUDS=10
PLAN_BASIC_MAX_EVENTS=50
PLAN_PREMIUM_MAX_AUDS=999
PLAN_PREMIUM_MAX_EVENTS=9999

# ===== WAITLIST (FUTURE-04) =====
WAITLIST_NOTIFY_WINDOW_MIN=30
